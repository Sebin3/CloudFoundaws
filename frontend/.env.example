# URL base de la API backend desplegada en Railway (sin /api).
# En desarrollo no es necesaria: Vite usa el proxy /api -> http://localhost:4000.
#
# Copia este archivo a frontend/.env.local para pruebas locales, o configúrala
# como variable de entorno "VITE_API_URL" en el proyecto de Vercel (se inyecta
# en tiempo de build, así que tras cambiarla hay que re-desplegar).
VITE_API_URL=https://tu-backend.up.railway.app
# Valores públicos del proyecto Supabase. Nunca pongas aquí la service role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
