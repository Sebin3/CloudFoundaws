{
  "name": "cloudfoundations-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API REST del CloudOps Dashboard para almacenar y servir los datos de la solución Cloud.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.1",
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.2",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3"
  }
}
